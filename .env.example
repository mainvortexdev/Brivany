# Copy to .env in the project root. Put your own values after =.
# Leave credentials blank for local features and offline tests.

# Meta · Melodi, translation, agents, research and image generation.
BRIVANY_META_API_KEY=
BRIVANY_META_MODEL=muse-spark-1.3
BRIVANY_META_BASE_URL=https://api.meta.ai/v1

# Muse Voice Transcribe · speech recognition. Falls back to the Meta key.
BRIVANY_MUSE_API_KEY=
BRIVANY_META_AUDIO_MODEL=

# Cartesia · speech for Melodi and the translated audio track.
BRIVANY_CARTESIA_API_KEY=

# Optional Meta model overrides for video and Sous vision.
BRIVANY_HUMAN_SKILLS_MODEL=muse-spark-1.2
BRIVANY_SOUS_MODEL=

# Optional Google OAuth. The connected account authorizes scopes separately.
BRIVANY_GOOGLE_CLIENT_ID=
BRIVANY_GOOGLE_CLIENT_SECRET=

# Optional WhatsApp Cloud API and signed webhook.
BRIVANY_WHATSAPP_ACCESS_TOKEN=
BRIVANY_META_APP_SECRET=
BRIVANY_WHATSAPP_VERIFY_TOKEN=

# Telnyx · phone calls by Melodi. Used by `python -m tools.setup_telnyx` to create
# Brivany's SIP connection; calls then go out from this computer over SIP.
BRIVANY_TELNYX_API_KEY=

# Telnyx Call Control v2: preferred transport when TELNYX_CONNECTION_ID is set.
# API host is https://api.telnyx.com/v2. Never use the SIP connection ID here.
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
# Verified Dominican E.164 caller ID, e.g. +18295550100 (synthetic example).
TELNYX_FROM_NUMBER=
# Public HTTPS origin only; the service appends /webhooks/telnyx.
WEBHOOK_BASE_URL=
# Account Ed25519 public key, retrieved by setup_telnyx_control (not an API key).
TELNYX_PUBLIC_KEY=
# Exclusive local bearer token generated by setup; required to initiate calls.
BRIVANY_TELNYX_CONTROL_TOKEN=
BRIVANY_TELNYX_CONTROL_PORT=8791

# Optional Meta Graph API integrations, with feature-specific scopes.
BRIVANY_META_SOCIAL_USER_TOKEN=
BRIVANY_FACEBOOK_PAGE_TOKEN=
BRIVANY_INSTAGRAM_ACCESS_TOKEN=
BRIVANY_META_ADS_ACCESS_TOKEN=

# Legacy/experimental adapters. The main audio translation path uses Meta + Cartesia.
BRIVANY_OPENAI_API_KEY=
BRIVANY_PALABRA_API_KEY=
BRIVANY_ELEVENLABS_API_KEY=
BRIVANY_ELEVENLABS_VOICE_ID=
BRIVANY_GEMINI_API_KEY=
BRIVANY_GROQ_API_KEY=
BRIVANY_CLOUDFLARE_ACCOUNT_ID=
BRIVANY_CLOUDFLARE_API_TOKEN=
BRIVANY_CLOUDFLARE_USE_WRANGLER=false
BRIVANY_DEEPGRAM_API_KEY=
BRIVANY_DEEPGRAM_MODEL=
