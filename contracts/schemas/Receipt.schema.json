{
  "additionalProperties": false,
  "properties": {
    "receipt_id": {
      "format": "uuid",
      "title": "Receipt Id",
      "type": "string"
    },
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "device_id": {
      "format": "uuid",
      "title": "Device Id",
      "type": "string"
    },
    "state": {
      "enum": [
        "succeeded",
        "failed",
        "uncertain"
      ],
      "title": "State",
      "type": "string"
    },
    "project_revision_before": {
      "title": "Project Revision Before",
      "type": "string"
    },
    "project_revision_after": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Revision After"
    },
    "observation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observation Id"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "detail": {
      "title": "Detail",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "command_id",
    "workspace_id",
    "session_id",
    "device_id",
    "state",
    "project_revision_before",
    "recorded_at",
    "detail"
  ],
  "title": "Receipt",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:brivany:schema:Receipt:0.1.0"
}
