{
  "additionalProperties": false,
  "properties": {
    "evidence_id": {
      "format": "uuid",
      "title": "Evidence Id",
      "type": "string"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "step_id": {
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Step Id",
      "type": "string"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "observation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observation Id"
    },
    "origin": {
      "enum": [
        "native",
        "derived",
        "visual",
        "expert",
        "learner"
      ],
      "title": "Origin",
      "type": "string"
    },
    "artifact_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Artifact Ids",
      "type": "array"
    },
    "signal_keys": {
      "items": {
        "maxLength": 120,
        "pattern": "^[a-z][a-z0-9_.-]*$",
        "type": "string"
      },
      "title": "Signal Keys",
      "type": "array"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "producer_id": {
      "title": "Producer Id",
      "type": "string"
    },
    "note": {
      "title": "Note",
      "type": "string"
    }
  },
  "required": [
    "evidence_id",
    "workspace_id",
    "session_id",
    "step_id",
    "attempt",
    "origin",
    "recorded_at",
    "producer_id",
    "note"
  ],
  "title": "Evidence",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:brivany:schema:Evidence:0.1.0"
}
