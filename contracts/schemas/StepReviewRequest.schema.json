{
  "additionalProperties": false,
  "properties": {
    "expected_revision": {
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    },
    "step_id": {
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Step Id",
      "type": "string"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "check_id": {
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Check Id",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "NEEDS_REVIEW"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "expected_revision",
    "step_id",
    "attempt",
    "check_id",
    "evidence_ids",
    "verdict",
    "reason"
  ],
  "title": "StepReviewRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:brivany:schema:StepReviewRequest:0.1.0"
}
