{
  "$defs": {
    "JsonValue": {},
    "ToolProposal": {
      "additionalProperties": false,
      "properties": {
        "tool_name": {
          "maxLength": 120,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Tool Name",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "tool_name",
        "arguments",
        "rationale"
      ],
      "title": "ToolProposal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "device_id": {
      "format": "uuid",
      "title": "Device Id",
      "type": "string"
    },
    "tool": {
      "$ref": "#/$defs/ToolProposal"
    },
    "action_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Action Sha256",
      "type": "string"
    },
    "project_ref": {
      "title": "Project Ref",
      "type": "string"
    },
    "expected_project_revision": {
      "title": "Expected Project Revision",
      "type": "string"
    },
    "expected_observation_id": {
      "format": "uuid",
      "title": "Expected Observation Id",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 200,
      "minLength": 8,
      "title": "Idempotency Key",
      "type": "string"
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Risk",
      "type": "string"
    },
    "reversibility": {
      "enum": [
        "read_only",
        "reversible",
        "irreversible"
      ],
      "title": "Reversibility",
      "type": "string"
    },
    "approval_required": {
      "title": "Approval Required",
      "type": "boolean"
    },
    "authorization_ref": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Authorization Ref"
    },
    "state": {
      "enum": [
        "proposed",
        "awaiting_approval",
        "authorized",
        "dispatched",
        "succeeded",
        "failed",
        "uncertain",
        "cancelled",
        "expired"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "command_id",
    "workspace_id",
    "session_id",
    "device_id",
    "tool",
    "action_sha256",
    "project_ref",
    "expected_project_revision",
    "expected_observation_id",
    "issued_at",
    "expires_at",
    "idempotency_key",
    "risk",
    "reversibility",
    "approval_required",
    "state"
  ],
  "title": "Command",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:brivany:schema:Command:0.1.0"
}
