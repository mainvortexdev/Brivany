<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Melodi WorkSpace</title><link rel="stylesheet" href="/desktop-shell/island.css"><script src="/desktop-shell/island.js" defer></script></head>
<body data-expanded="false" data-sleeping="false">
<main id="island" aria-label="Melodi WorkSpace">
 <header class="toolstrip" aria-label="Herramientas de Melodi">
  <div class="eye-track" aria-hidden="true"><span class="eye-wander"><span class="face"><i class="eye"></i><i class="eye"></i></span></span></div>
  <nav id="tools" aria-label="Herramientas">
   <button data-panel="screen" aria-label="Pantalla" title="Capturar una región"><svg viewBox="0 0 24 24"><path d="M8 3H5a2 2 0 0 0-2 2v3m13-5h3a2 2 0 0 1 2 2v3M3 16v3a2 2 0 0 0 2 2h3m13-5v3a2 2 0 0 1-2 2h-3M9 9h6v6H9z"/></svg><span>Pantalla</span></button>
   <button data-panel="translation" aria-label="Traducir" title="Traducir audio del sistema"><svg viewBox="0 0 24 24"><path d="M3 5h11M8 3v2m4 0c0 7-8 10-8 10m1-7 7 7m1 6 4-11 4 11m-6-4h4"/></svg><span>Traducir</span></button>
   <button class="secondary-tool" data-route="/spaces" title="Espacios 3D"><svg viewBox="0 0 24 24"><path d="m12 3 9 5v9l-9 5-9-5V8zm0 10 9-5M3 8l9 5v9"/></svg><span>Espacios</span></button>
   <button class="secondary-tool" data-route="/human-skills" title="Human-skills"><svg viewBox="0 0 24 24"><path d="m12 2 2 7 7 3-7 2-2 8-2-8-8-2 8-3z"/></svg><span>Skills</span></button>
   <button class="secondary-tool" data-route="/dubbing" title="Video y traducción"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m10 9 5 3-5 3z"/></svg><span>Video</span></button>
   <button data-panel="music" aria-label="Música" title="Spotify"><svg viewBox="0 0 24 24"><path d="M9 17V5l11-2v12M9 8l11-2"/><ellipse cx="6" cy="18" rx="3" ry="3"/><ellipse cx="17" cy="16" rx="3" ry="3"/></svg><span>Música</span></button>
   <button class="secondary-tool" data-route="/connections" title="Conexiones"><svg viewBox="0 0 24 24"><path d="M8 2v5m8-5v5M5 7h14v3a7 7 0 0 1-14 0zm7 10v5"/></svg><span>Conexiones</span></button>
   <button data-panel="more" aria-label="Más herramientas" title="Todas las herramientas"><svg viewBox="0 0 24 24"><circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/></svg><span>Más</span></button>
   <button data-panel="settings" aria-label="Ajustes" title="Ajustes de WorkSpace"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 17h16"/><circle cx="9" cy="7" r="3"/><circle cx="15" cy="17" r="3"/></svg><span>Ajustes</span></button>
  </nav>
  <time id="bar-clock" aria-label="Hora"></time>
 </header>
 <div id="island-content" inert>
  <div class="panel-top"><span id="panel-label">Pantalla</span><button id="island-collapse" class="icon-button" aria-label="Cerrar panel" title="Cerrar panel"><svg viewBox="0 0 24 24"><path d="m7 7 10 10M7 17 17 7"/></svg></button></div>
  <section data-view="screen"><div class="intro"><span class="eyebrow">CONTEXTO A TU MEDIDA</span><h1>Solo lo que quieres compartir.</h1><p>Selecciona una parte de la pantalla y pídele a Melodi que la explique, traduzca o la use como referencia.</p></div><button id="work-region" class="primary">Seleccionar región <span>↗</span></button></section>
  <section data-view="translation" hidden><h1>Escucha. Comprende.</h1><label class="setting-row"><span>Detectar otro idioma<small>Audio del sistema</small></span><input id="work-listen" type="checkbox" role="switch"></label><p class="fine">Al activarlo, Muse recibe audio para detectar el idioma. Hasta 120 s previos en memoria. Tú decides si conservarlo y traducirlo.</p><section id="work-offer" class="offer" hidden><p></p><div class="actions"><button id="work-accept" class="primary">Conservar y traducir</button><button id="work-decline">Ahora no</button></div></section><button id="work-finish" class="primary" hidden>Finalizar grabación y traducir</button><audio id="work-audio-result" controls hidden></audio><p id="work-coverage" class="fine"></p></section>
  <section data-view="music" hidden>
   <div id="spotify-setup"><h1>Tu música, a mano.</h1><p>Vincula Spotify para controlar tus canciones y elegir dónde escucharlas.</p><form id="spotify-config"><label for="spotify-client">Client ID de Spotify</label><div class="input-row"><input id="spotify-client" autocomplete="off" spellcheck="false" placeholder="Client ID de tu aplicación" maxlength="32"><button type="submit">Guardar</button></div></form><div class="setup-help"><button id="spotify-dashboard" class="text-button">Crear o abrir mi app en Spotify ↗</button><p class="fine">Añade este Redirect URI en la app de Spotify:</p><code>http://127.0.0.1/spotify/callback</code><p class="fine">El propietario de la app necesita Premium. En modo desarrollo, añade tu cuenta a la lista de usuarios permitidos.</p></div><div class="actions"><button id="spotify-connect" class="primary" disabled>Vincular Spotify ↗</button><button id="spotify-edit" class="text-button" hidden>Cambiar Client ID</button></div><p id="spotify-pending" class="fine" hidden>Completa la vinculación en tu navegador.</p><p id="spotify-storage" class="fine" hidden>La sesión se conserva solo mientras Brivany esté abierto en este sistema.</p></div>
   <div id="spotify-player" hidden>
    <div class="music-tabs" role="tablist" aria-label="Reproductor"><button data-music-view="player" role="tab" aria-selected="true">Reproductor</button><button data-music-view="lyrics" role="tab" aria-selected="false">Letra</button><button id="spotify-disconnect" class="text-button">Desvincular</button></div>
    <div id="music-player-view"><div class="now-playing"><img id="track-art" alt="Portada del álbum" hidden><div class="art-empty" aria-hidden="true">♪</div><div class="track-meta"><span class="eyebrow">SPOTIFY</span><h1 id="track-title">Nada en reproducción</h1><p id="track-artist">Abre Spotify en uno de tus dispositivos.</p><button id="spotify-open" class="text-button" disabled>Abrir en Spotify ↗</button></div></div><div class="seek-row"><input id="music-seek" type="range" min="0" max="100" value="0" aria-label="Posición de reproducción" disabled><div><time id="music-elapsed">0:00</time><time id="music-duration">0:00</time></div></div><div class="playback-controls"><button id="music-shuffle" class="icon-button" aria-label="Aleatorio" disabled>⤨</button><button id="music-prev" class="icon-button" aria-label="Canción anterior" disabled>⏮</button><button id="music-play" class="play-button" aria-label="Reproducir" disabled>▶</button><button id="music-next" class="icon-button" aria-label="Canción siguiente" disabled>⏭</button><button id="music-repeat" class="icon-button" aria-label="Repetir" disabled>↻</button></div><div class="device-row"><label for="music-device">Escuchar en</label><select id="music-device" aria-label="Dispositivo de reproducción"><option value="">Sin dispositivos</option></select><input id="music-volume" type="range" min="0" max="100" value="50" aria-label="Volumen" disabled></div></div>
    <div id="music-lyrics-view" hidden><div id="lyrics-lines" aria-live="off"></div><div class="lyrics-footer"><span id="lyrics-source" class="fine">Letra local · LRC o TXT</span><button id="lyrics-prev" class="icon-button" aria-label="Página anterior de letra">↑</button><button id="lyrics-next" class="icon-button" aria-label="Página siguiente de letra">↓</button><button id="lyrics-import" class="text-button">Importar letra</button></div></div>
   </div><p id="music-status" role="status" class="fine"></p>
  </section>
  <section data-view="more" hidden><h1>Un acceso. Cada posibilidad.</h1><div class="module-grid"><button data-route="/spaces">Espacios 3D <span>↗</span></button><button data-route="/human-skills">Human-skills <span>↗</span></button><button data-route="/practice">Práctica <span>↗</span></button><button data-route="/dubbing">Video y traducción <span>↗</span></button><button id="workspace-edits">Cognira Edits <span>↗</span></button><button data-route="/sous">Sous <span>↗</span></button><button data-route="/connections">Conexiones <span>↗</span></button><button data-route="/activity">Bitácora <span>↗</span></button><button data-route="/desktop-services">Servicios <span>↗</span></button></div></section>
  <section data-view="settings" hidden><h1>Menos ruido. Más espacio.</h1><label class="setting-row"><span>Animaciones<small>Respeta el movimiento reducido del sistema</small></span><input id="island-motion" type="checkbox" role="switch" checked></label><label class="setting-row"><span>Reposo de los ojos<small>Duermen tras 20 segundos sin actividad observada</small></span><input id="island-sleep" type="checkbox" role="switch" checked></label><div class="actions"><button id="workspace-settings">Ajustes de la app ↗</button><button id="work-close" class="text-button">Salir de WorkSpace</button></div></section>
  <p id="work-status" role="status" aria-live="polite"></p>
 </div>
</main></body></html>
