        send_lock=threading.Lock(); resources_lock=threading.Lock(); resources=[]; threads=[]
        context_condition=threading.Condition(threading.RLock()); contexts={}; play_order=deque(); context_slots=threading.BoundedSemaphore(MAX_CONTEXTS)
        prosody_jobs={};prosody_slots=threading.BoundedSemaphore(MAX_CONTEXTS)
