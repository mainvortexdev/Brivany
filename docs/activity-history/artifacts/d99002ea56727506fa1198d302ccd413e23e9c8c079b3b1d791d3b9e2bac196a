 window.addEventListener('brivany-reference-error',event=>status(event.detail,true));
 window.BrivanyChat={send,clear:()=>{cancel();stopLive();window.BrivanyImageRequest?.clear();session.messages=[];session.history=[];seen.clear();notices=[];render();status();input.value='';resize();},stopLive,taskStatus:jobs=>{$('#stop-tasks').hidden=!jobs.some(job=>['queued','planning','running'].includes(job.state));}};
 fetch('/api/status',{cache:'no-store'}).then(response=>response.json()).then(value=>config=value).catch(()=>{});render();
 window.addEventListener('pagehide',()=>{cancel();stopLive();channel?.close();observer.disconnect();previewObserver.disconnect();clearInterval(notificationTimer);},{once:true});
})();
