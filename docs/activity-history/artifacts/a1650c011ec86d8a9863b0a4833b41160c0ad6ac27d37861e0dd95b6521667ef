"""Real loopback Cartesia WS protocol, synthetic PCM only; no paid calls."""
import base64
from http.client import HTTPConnection
from http.server import ThreadingHTTPServer
import json
import os
import socket
import threading
import time
import unittest
from unittest.mock import patch
from websockets.sync.server import serve
from packages.providers import cartesia_melodi as tts
from packages.providers.live_voice import VoiceError
from services.h1.server import Handler


class CartesiaMelodiTests(unittest.TestCase):
    def setUp(self):
        self.requests=[];self.auth=[];self.cancelled=threading.Event();self.idle=False;self.reject=False;self.pcm=b'\x00\x03'*5000
        def provider(ws):
            self.auth.append(ws.request.headers.get('X-API-Key'))
            try:
                event=json.loads(ws.recv());self.requests.append(event)
                if self.reject:ws.send(json.dumps({'type':'error','message':'private provider diagnostic'}));return
                if not self.idle:
                    ws.send(json.dumps({'type':'chunk','context_id':event['context_id'],'data':base64.b64encode(self.pcm).decode()}))
                    ws.send(json.dumps({'type':'done','context_id':event['context_id']}))
                for raw in ws:
                    if json.loads(raw).get('cancel'):self.cancelled.set()
            except Exception:pass
        self.server=serve(provider,'127.0.0.1',0,compression=None);threading.Thread(target=self.server.serve_forever,daemon=True).start()
        self.env=patch.dict(os.environ,{'BRIVANY_CARTESIA_API_KEY':'synthetic-secret'})
        self.url=patch.object(tts,'URL',f'ws://127.0.0.1:{self.server.socket.getsockname()[1]}')
        self.env.start();self.url.start()

    def tearDown(self):self.server.shutdown();self.url.stop();self.env.stop()

    def test_two_languages_send_exact_ids_and_stream_pcm_without_secret_output(self):
        for language in ('es','en'):
            with tts.open_cartesia_speech('Synthetic phrase.',language) as stream:
                pcm=b''
                while block:=stream.read1(4096):pcm+=block
                self.assertEqual(pcm,self.pcm)
            event=self.requests[-1]
            self.assertEqual(event['voice'],tts.VOICES[language]);self.assertEqual(event['language'],language)
            self.assertEqual(event['model_id'],tts.MODEL);self.assertFalse(event['continue'])
            self.assertEqual(event['output_format'],{'container':'raw','encoding':'pcm_s16le','sample_rate':24000})
            self.assertNotIn('synthetic-secret',json.dumps(event))
        self.assertEqual(len(self.requests),2);self.assertEqual(self.auth,['synthetic-secret']*2)

    def test_cancel_interrupts_idle_receive_and_sends_context_cancel(self):
        self.idle=True
        stream=tts.open_cartesia_speech('Synthetic phrase.');result=[]
        reader=threading.Thread(target=lambda:result.append(stream.read1()),daemon=True);reader.start()
        deadline=time.monotonic()+1
        while not self.requests and time.monotonic()<deadline:time.sleep(.01)
        stream.close();reader.join(.5)
        self.assertFalse(reader.is_alive());self.assertEqual(result,[b'']);self.assertTrue(self.cancelled.wait(.5))

    def test_rejection_has_no_retry_and_no_provider_body_leak(self):
        self.reject=True
        with tts.open_cartesia_speech('Synthetic phrase.') as stream:
            with self.assertRaises(VoiceError) as error:stream.read1()
        self.assertEqual(error.exception.code,'tts_rejected');self.assertNotIn('private',str(error.exception));self.assertEqual(len(self.requests),1)

    def test_invalid_input_and_language_do_not_open_socket(self):
        for text,language in [('', 'es'),('x'*1801,'es'),('hello','fr')]:
            with self.assertRaises(VoiceError):tts.open_cartesia_speech(text,language)
        self.assertEqual(self.requests,[])

    def test_http_route_selects_english_voice_and_forbids_voice_override(self):
        http=ThreadingHTTPServer(('127.0.0.1',0),Handler);thread=threading.Thread(target=http.serve_forever,daemon=True);thread.start()
        try:
            for body,expected in [({'text':'Hello.','language':'en','consent':True},200),
                ({'text':'Hello.','language':'fr','consent':True},422),
                ({'text':'Hello.','language':'en','consent':True,'voice':'arbitrary'},422)]:
                conn=HTTPConnection('127.0.0.1',http.server_port,timeout=3)
                conn.request('POST','/api/voice/speech',json.dumps(body),{'Content-Type':'application/json'})
                response=conn.getresponse();self.assertEqual(response.status,expected);data=response.read();conn.close()
                if expected==200:self.assertEqual(data,self.pcm)
            self.assertEqual(len(self.requests),1);self.assertEqual(self.requests[0]['voice'],tts.VOICES['en'])
        finally:http.shutdown();http.server_close();thread.join(2)

    def test_aborted_http_client_cancels_cartesia_before_audio_arrives(self):
        self.idle=True
        http=ThreadingHTTPServer(('127.0.0.1',0),Handler);thread=threading.Thread(target=http.serve_forever,daemon=True);thread.start()
        client=socket.create_connection(('127.0.0.1',http.server_port),timeout=3)
        body=json.dumps({'text':'Synthetic phrase.','language':'es','consent':True}).encode()
        try:
            client.sendall(f'POST /api/voice/speech HTTP/1.1\r\nHost: 127.0.0.1:{http.server_port}\r\nContent-Type: application/json\r\nContent-Length: {len(body)}\r\n\r\n'.encode()+body)
            deadline=time.monotonic()+2
            while not self.requests and time.monotonic()<deadline:time.sleep(.01)
            self.assertTrue(self.requests)
            client.close();self.assertTrue(self.cancelled.wait(1),'Fetch disconnect must cancel the idle provider')
        finally:client.close();http.shutdown();http.server_close();thread.join(2)


if __name__=='__main__':unittest.main()
