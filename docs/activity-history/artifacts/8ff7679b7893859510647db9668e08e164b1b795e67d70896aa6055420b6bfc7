<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Melodi WorkSpace</title><link rel="stylesheet" href="/desktop-shell/island.css"><link rel="stylesheet" href="/desktop-shell/workspace-music.css"><link rel="stylesheet" href="/desktop-shell/character.css"><script src="/desktop-shell/music-motion.js" defer></script><script src="/desktop-shell/island.js" defer></script></head>
<body data-expanded="false" data-sleeping="false">
<main id="island" aria-label="Melodi WorkSpace">
 <header class="toolstrip" aria-label="Herramientas de Melodi"><div class="workspace-waves" aria-hidden="true"><svg viewBox="0 0 1920 48" preserveAspectRatio="none"><path d="M0 24 Q60 2 120 24 T240 24 Q300 2 360 24 T480 24 Q540 2 600 24 T720 24 Q780 2 840 24 T960 24 Q1020 2 1080 24 T1200 24 Q1260 2 1320 24 T1440 24 Q1500 2 1560 24 T1680 24 Q1740 2 1800 24 T1920 24 "/></svg><svg viewBox="0 0 1920 48" preserveAspectRatio="none"><path d="M0 24 Q60 2 120 24 T240 24 Q300 2 360 24 T480 24 Q540 2 600 24 T720 24 Q780 2 840 24 T960 24 Q1020 2 1080 24 T1200 24 Q1260 2 1320 24 T1440 24 Q1500 2 1560 24 T1680 24 Q1740 2 1800 24 T1920 24 "/></svg><svg viewBox="0 0 1920 48" preserveAspectRatio="none"><path d="M0 24 Q60 2 120 24 T240 24 Q300 2 360 24 T480 24 Q540 2 600 24 T720 24 Q780 2 840 24 T960 24 Q1020 2 1080 24 T1200 24 Q1260 2 1320 24 T1440 24 Q1500 2 1560 24 T1680 24 Q1740 2 1800 24 T1920 24 "/></svg></div>
  <nav id="tools" aria-label="Herramientas"><div class="tool-group tools-left">
   <button data-panel="screen" aria-label="Pantalla"><span>Pantalla</span></button>
   <button class="overflow-tool" data-panel="translation" aria-label="Traducir"><span>Traducir</span></button>
   <button class="secondary-tool" data-panel="spaces"><span>Espacios</span></button>
   <button class="secondary-tool" data-panel="skills"><span>Skills</span></button>
   <button class="secondary-tool" data-panel="video"><span>Video</span></button>
  </div><div class="eye-bay" aria-hidden="true"><div class="eye-track"><span class="eye-wander"><span class="face melodi-character"><span class="mascot-shadow"></span><span class="mascot-hand left"></span><span class="mascot-hand right"></span><span class="mascot-body"><span class="mascot-headphones"><i class="headphone-band"></i><i class="headphone-cup left"></i><i class="headphone-cup right"></i></span><span class="mascot-look"><i class="eye"></i><i class="eye"></i></span><i class="mascot-cheek left"></i><i class="mascot-cheek right"></i></span><span class="mascot-sleep">z</span></span></span></div></div><div class="tool-group tools-right">
   <button data-panel="music" aria-label="Música"><span>Música</span></button>
   <button class="secondary-tool" data-panel="connections"><span>Conexiones</span></button>
   <button data-panel="more" aria-label="Más herramientas"><span>Más</span></button>
   <button class="overflow-tool" data-panel="settings" aria-label="Ajustes"><span>Ajustes</span></button>
  <time id="bar-clock" aria-label="Hora"></time></div></nav>
 </header>
 <div id="island-content" inert>
  <div class="panel-top"><span id="panel-label">Pantalla</span><button id="island-collapse" class="icon-button" aria-label="Cerrar panel"><svg viewBox="0 0 24 24"><path d="m7 7 10 10M7 17 17 7"/></svg></button></div>
  <section data-view="screen"><p class="capture-description">Selecciona una región para explicarla, traducirla o usarla como referencia.</p><button id="work-region" class="primary">Seleccionar región <span>↗</span></button></section>
  <section data-view="spaces"><p class="capture-description">Tus escenas, modelos y proyectos, en un solo lugar.</p><button data-route="/spaces" class="primary">Abrir mis espacios <span>↗</span></button></section>
  <section data-view="skills"><div class="quick-actions"><button data-route="/human-skills">Human-skills <span>↗</span></button><button data-route="/practice">Practicar una habilidad <span>↗</span></button><button data-route="/sous">Sous <span>↗</span></button></div></section>
  <section data-view="video"><div class="quick-actions"><button data-route="/dubbing">Video y traducción <span>↗</span></button><button data-action="open-edits">Editar con Cognira Edits <span>↗</span></button></div></section>
  <section data-view="connections"><p class="capture-description">Revisa tus cuentas y los servicios conectados a Melodi.</p><button data-route="/connections" class="primary">Gestionar conexiones <span>↗</span></button></section>
  <section data-view="translation" hidden><h1>Escucha. Comprende.</h1><label class="setting-row"><span>Detectar otro idioma<small>Audio del sistema</small></span><input id="work-listen" type="checkbox" role="switch"></label><p class="fine">Al activarlo, Muse recibe audio para detectar el idioma. Hasta 120 s previos en memoria. Tú decides si conservarlo y traducirlo.</p><section id="work-offer" class="offer" hidden><p></p><div class="actions"><button id="work-accept" class="primary">Conservar y traducir</button><button id="work-decline">Ahora no</button></div></section><button id="work-finish" class="primary" hidden>Finalizar grabación y traducir</button><audio id="work-audio-result" controls hidden></audio><p id="work-coverage" class="fine"></p></section>
  <section data-view="music" hidden>
   <div id="spotify-setup"><div class="connect-intro"><h1>Tu música, contigo.</h1><p>Conecta tu cuenta y elige dónde escuchar.</p></div><button id="spotify-connect" class="primary">Vincular Spotify <span aria-hidden="true">↗</span></button><p id="spotify-pending" class="fine" hidden>Completa el inicio de sesión en tu navegador. Este panel se actualizará al volver.</p><p id="spotify-storage" class="fine" hidden>La sesión se conserva mientras Brivany esté abierto en este sistema.</p></div>
   <div id="spotify-player" hidden>
    <div class="player-strip">
     <div class="now-playing"><div class="cover"><img id="track-art" alt="Portada del álbum" hidden><div class="art-empty" aria-hidden="true">♪</div></div><div class="track-meta"><span id="track-state" class="track-state"></span><h1 id="track-title">Sin reproducción activa</h1><p id="track-artist">Elige música de tu biblioteca.</p></div></div>
     <div id="music-lyrics-view" class="inline-lyrics"><div id="lyrics-lines" tabindex="0" aria-label="Letra de la canción. Desplaza para leer letras sin sincronizar." aria-live="off"></div></div>
     <div class="transport"><div class="playback-controls"><button id="music-shuffle" class="icon-button" aria-label="Aleatorio" aria-pressed="false" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h2c5 0 7 10 12 10h2m-4-3 4 3-4 3M4 17h2c2 0 3-2 4-4m4-2c1-2 2-4 4-4h2m-4-3 4 3-4 3"/></svg></button><button id="music-prev" class="icon-button" aria-label="Canción anterior" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5v14"/><path d="m18 5-10 7 10 7Z" class="solid"/></svg></button><button id="music-play" class="play-button" aria-label="Reproducir" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 11 7-11 7Z" class="solid play-glyph"/><path d="M8 5h3v14H8zm6 0h3v14h-3z" class="solid pause-glyph"/></svg></button><button id="music-next" class="icon-button" aria-label="Canción siguiente" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 5v14"/><path d="m6 5 10 7-10 7Z" class="solid"/></svg></button><button id="music-repeat" class="icon-button" aria-label="Repetir" aria-pressed="false" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m17 2 4 4-4 4M3 11V9a3 3 0 0 1 3-3h15M7 22l-4-4 4-4m14-1v2a3 3 0 0 1-3 3H3"/></svg></button></div><div class="seek-row"><time id="music-elapsed">0:00</time><input id="music-seek" type="range" min="0" max="100" value="0" aria-label="Posición de reproducción" disabled><time id="music-duration">0:00</time></div></div>
    </div>
    <div class="player-tools"><div class="music-navigation"><button id="music-refresh" class="music-tool refresh-music" aria-label="Actualizar reproducción"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 8a8 8 0 1 0 0 8M20 3v5h-5"/></svg></button><button data-music-view="library" class="music-tool" aria-label="Abrir biblioteca" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4v16M9 4v16m5-16 5 16M3 20h18"/></svg><span>Biblioteca</span></button></div><div class="device-tools"><button id="music-here" class="music-tool">Escuchar aquí</button><button id="music-device" class="music-tool" aria-label="Dispositivos de reproducción" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="13" height="11" rx="2"/><path d="M6 18h6m-3-4v4"/><rect x="17" y="9" width="4" height="12" rx="1"/></svg><span id="music-device-name">Dispositivos</span></button><label class="volume-control"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m11 4-6 5H2v6h3l6 5Zm4 4a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14"/></svg><input id="music-volume" type="range" min="0" max="100" value="50" aria-label="Volumen" disabled></label></div></div>
    <div id="music-devices-view" hidden><p class="music-section-label">Escuchar en</p><div id="music-devices" role="group" aria-label="Dispositivos disponibles"></div><p class="fine">Abre Spotify en el dispositivo que quieras usar.</p></div>
    <div id="music-library-view" hidden><div class="library-tabs" role="tablist" aria-label="Tu biblioteca"><button data-library="playlists" role="tab" aria-selected="true">Playlists</button><button data-library="albums" role="tab" aria-selected="false">Álbumes</button><button data-library="tracks" role="tab" aria-selected="false">Canciones</button></div><div id="music-library" role="group" aria-label="Biblioteca de Spotify"></div></div>

   </div><p id="music-status" role="status" class="fine"></p>
  </section>
  <section data-view="more" hidden><h1>Un acceso. Cada posibilidad.</h1><div class="module-grid"><button data-open-panel="translation">Traducir audio <span>↗</span></button><button data-open-panel="settings">Ajustes <span>↗</span></button><button data-route="/spaces">Espacios 3D <span>↗</span></button><button data-route="/human-skills">Human-skills <span>↗</span></button><button data-route="/practice">Práctica <span>↗</span></button><button data-route="/dubbing">Video y traducción <span>↗</span></button><button id="workspace-edits">Cognira Edits <span>↗</span></button><button data-route="/sous">Sous <span>↗</span></button><button data-route="/connections">Conexiones <span>↗</span></button><button data-route="/activity">Bitácora <span>↗</span></button><button data-route="/desktop-services">Servicios <span>↗</span></button></div></section>
  <section data-view="settings" hidden><h1>Menos ruido. Más espacio.</h1><label class="setting-row"><span>Animaciones<small>Respeta el movimiento reducido del sistema</small></span><input id="island-motion" type="checkbox" role="switch" checked></label><label class="setting-row"><span>Reposo de Melodi<small>Descansa tras 20 segundos sin actividad observada</small></span><input id="island-sleep" type="checkbox" role="switch" checked></label><div class="actions"><button id="workspace-settings">Ajustes de la app ↗</button><button id="work-close" class="text-button">Salir de WorkSpace</button></div></section>
  <p id="work-status" role="status" aria-live="polite"></p>
 </div>
</main></body></html>
