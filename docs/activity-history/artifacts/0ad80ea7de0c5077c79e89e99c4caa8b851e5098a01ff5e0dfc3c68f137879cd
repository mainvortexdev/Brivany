                ('nAvgBytesPerSec',ctypes.c_uint32),('nBlockAlign',ctypes.c_uint16),('wBitsPerSample',ctypes.c_uint16),('cbSize',ctypes.c_uint16)]
        class WaveHeader(ctypes.Structure):
