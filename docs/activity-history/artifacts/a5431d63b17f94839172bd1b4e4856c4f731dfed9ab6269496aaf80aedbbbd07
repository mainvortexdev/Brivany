/* Video audio only: explicit PCM16 LE mono 24 kHz, 40 ms packets. */
class BrivanyDubCapture extends AudioWorkletProcessor {
  constructor() {
    super(); this.frame=new Int16Array(960); this.index=0; this.phase=0; this.sum=0; this.count=0; this.active=false; this.generation=0;
    this.port.onmessage=event=>{
      if(event.data.flush===true) {
        if(event.data.generation!==this.generation) return;
        if(this.index) {
          const bytes=new ArrayBuffer(this.index*2), view=new DataView(bytes);
          for(let j=0;j<this.index;j++) view.setInt16(j*2,this.frame[j],true);
          this.port.postMessage({type:'pcm',buffer:bytes,generation:this.generation},[bytes]);
        }
        this.active=false; this.index=0; this.port.postMessage({type:'flushed',generation:this.generation}); return;
      }
      this.active=event.data.active===true; this.generation=event.data.generation ?? this.generation; this.index=0; this.phase=0; this.sum=0; this.count=0;
    };
  }
  process(inputs) {
    const channels=inputs[0];
    if(!this.active || !channels?.length) return true;
    for(let i=0;i<channels[0].length;i++) {
      let value=0; for(const channel of channels) value+=channel[i] || 0;
      this.sum+=value/channels.length; this.count++; this.phase+=24000;
      if(this.phase>=sampleRate) {
        this.phase-=sampleRate;
        const sample=Math.max(-1,Math.min(1,this.sum/this.count));
        this.frame[this.index++]=Math.round(sample*(sample<0?32768:32767)); this.sum=0; this.count=0;
        if(this.index===this.frame.length) {
          const bytes=new ArrayBuffer(this.frame.length*2), view=new DataView(bytes);
          for(let j=0;j<this.frame.length;j++) view.setInt16(j*2,this.frame[j],true);
          this.port.postMessage({type:'pcm',buffer:bytes,generation:this.generation},[bytes]); this.index=0;
        }
      }
    }
    return true;
  }
}
registerProcessor('brivany-dub-capture',BrivanyDubCapture);
