{
  "manifest_version": 3,
  "name": "Brivany · Videos con Melodi",
  "version": "0.4.0",
  "minimum_chrome_version": "116",
  "description": "Transcribe y escucha la traducción del video seleccionado mientras se reproduce.",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "tabCapture",
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_title": "Seleccionar video para Melodi"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      }
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:*; media-src 'self' blob:; img-src 'self' data:; style-src 'self'"
  },
  "key": "",
  "web_accessible_resources": [
    {
      "resources": [
        "video-selection.js",
        "caption-probe.js",
        "pcm-capture.js",
        "pcm-sender.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}