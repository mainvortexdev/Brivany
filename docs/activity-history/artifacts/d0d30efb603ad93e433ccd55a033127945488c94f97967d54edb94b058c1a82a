        windows.append({'title':title.value,'native_handle':int(hwnd),'visible':bool(user.IsWindowVisible(hwnd)),'bounds':rect_value(bounds),'tool_window':bool(style&0x80),'app_window':bool(style&0x40000),'alpha':alpha.value if layered else None})
        monitor=user.MonitorFromWindow(hwnd,2);return True
