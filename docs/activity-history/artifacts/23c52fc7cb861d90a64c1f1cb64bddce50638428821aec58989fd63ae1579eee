class SpotifyError(ValueError):pass


class NoRedirect(HTTPRedirectHandler):
    def redirect_request(self,*args,**kwargs):return None


def transport(method,url,headers,body):
    parsed=urlsplit(url)
    if parsed.scheme!='https' or parsed.hostname not in {'accounts.spotify.com','api.spotify.com'} or parsed.port or parsed.username or parsed.password:
        raise SpotifyError('Destino Spotify inválido.')
    try:
        response=build_opener(NoRedirect(),HTTPSHandler(context=verified_context())).open(Request(url,data=body,headers=headers,method=method),timeout=12)
    except HTTPError as error:response=error
    except (URLError,OSError):raise SpotifyError('No se pudo conectar con Spotify. Comprueba tu conexión.') from None
    with response:
        raw=response.read(1048577)
        if len(raw)>1048576:raise SpotifyError('Respuesta Spotify demasiado grande.')
        try:data=json.loads(raw) if raw else {}
        except (ValueError,UnicodeError):data={}
        return response.code,dict(response.headers),data


def parse_lyrics(text):
    """User-supplied LRC/TXT only. Never an instruction or an executable asset."""
    if not isinstance(text,str) or len(text)>65536:raise SpotifyError('La letra supera el límite de 64 KB.')
    rows=[];offset=0
    match=re.search(r'\[offset:([+-]?\d+)\]',text)
    if match:offset=max(-60000,min(60000,int(match[1])))
    for line in text.splitlines():
        stamps=re.findall(r'\[(\d{1,3}):(\d{2})(?:[.:](\d{1,3}))?\]',line)
        words=re.sub(r'\[[^\]]*\]','',line).strip()[:400]
        if not words:continue
        if stamps:
            for minute,second,fraction in stamps:
                if int(second)<60:rows.append({'ms':max(0,int(minute)*60000+int(second)*1000+int((fraction+'000')[:3])+offset),'text':words})
        elif not line.startswith('['):rows.append({'ms':None,'text':words})
        if len(rows)>800:raise SpotifyError('La letra supera las 800 líneas.')
    synced=bool(rows) and all(row['ms'] is not None for row in rows)
    if synced:rows.sort(key=lambda row:row['ms'])
    return {'synced':synced,'lines':rows}


