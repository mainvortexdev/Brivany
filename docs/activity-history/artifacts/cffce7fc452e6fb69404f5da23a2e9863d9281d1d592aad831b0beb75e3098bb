            self.control_generation+=1;self.stopped=threading.Event();self.target=target;self.voice=voice;self.pcm=queue.Queue(maxsize=1500);self.controls=queue.Queue(maxsize=4);self.submitted=0;self.captured=0;self.started=time.monotonic();self.route_ready=threading.Event();self.route=None
