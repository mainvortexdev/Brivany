:root{color-scheme:dark;--ink:#f4f4f5;--muted:#94969e;--mint:#a3f4d0;--island-width:336px;--island-height:48px;--ease:cubic-bezier(.22,1,.36,1);--motion:280ms}
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:transparent}body{display:flex;justify-content:center;align-items:flex-start;color:var(--ink);font:12px/1.45 'Segoe UI',sans-serif;-webkit-font-smoothing:antialiased;user-select:none}button,input{font:inherit}button{color:inherit;cursor:pointer;border:0;background:transparent;touch-action:manipulation}button:disabled{opacity:.45;cursor:wait}button:focus-visible,input:focus-visible{outline:2px solid var(--mint);outline-offset:3px}button:active{transform:scale(.975)}svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}button svg{pointer-events:none}button{transition:color 160ms,background 160ms,transform 180ms var(--ease)}[hidden]{display:none!important}
.island{position:relative;isolation:isolate;flex:none;width:min(var(--island-width),100vw);height:min(var(--island-height),100vh);overflow:hidden;border-radius:0 0 24px 24px;background:#050506;border:1px solid #ffffff0b;border-top:0;box-shadow:0 10px 35px #0006;transition:width var(--motion) var(--ease),height var(--motion) var(--ease),border-radius var(--motion) var(--ease)}.island:before{content:'';position:absolute;z-index:-1;inset:0;opacity:0;background:radial-gradient(ellipse at 50% -50%,#a4efcf18,transparent 70%);transition:opacity 400ms}.island:hover:before{opacity:1}
.island-header{position:relative;display:flex;align-items:center;justify-content:space-between;height:48px;padding:0 17px;gap:16px}.brand{display:flex;align-items:center;gap:9px;min-width:0;padding:5px 0;text-align:left}.brand>span:last-child{min-width:0}.brand strong{display:none;font-size:12px;font-weight:550;letter-spacing:.01em}.brand small{display:block;max-width:130px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:10.5px;color:#c0c1c6}.brivany-mark{display:flex;align-items:center;justify-content:center;gap:2px;width:24px;height:25px;border-radius:8px;background:#152b24;color:var(--mint)}.brivany-mark i{display:block;width:2px;height:10px;border-radius:2px;background:currentColor;transform:rotate(-8deg)}.brivany-mark i:nth-child(2){height:15px}.brivany-mark i:nth-child(3){height:12px}
.face-button{position:absolute;left:50%;top:5px;transform:translateX(-50%);width:58px;height:38px;display:grid;place-items:center;border-radius:20px}.face-button:hover{background:#ffffff06}.face-button:active{transform:translateX(-50%) scale(.92)}.face{display:flex;gap:10px;align-items:center;justify-content:center;width:48px;height:30px;filter:drop-shadow(0 0 5px #c2ffe969);transform:translate(var(--look-x,0),var(--look-y,0));transition:transform 350ms var(--ease)}.eye{display:block;width:6px;height:10px;border-radius:100%;background:#dcffe9;box-shadow:0 0 8px #a8ffcf66;animation:blink 9s infinite;transform-origin:50% 55%;transition:height 240ms,width 240ms,background 240ms}.eye-right{animation-delay:35ms}.header-actions{display:flex;align-items:center;gap:13px}.signal{display:flex;align-items:center;justify-content:center;gap:3px;height:18px;color:#80b9a4}.signal i{width:2px;height:5px;border-radius:5px;background:currentColor;transform-origin:center}.signal i:nth-child(2),.signal i:nth-child(4){height:9px}.signal i:nth-child(3){height:14px}.icon-button{display:grid;place-items:center;width:25px;height:25px;border-radius:50%;color:#8b8d96}.icon-button:hover{background:#ffffff10;color:#fff}.expanded-control{display:none}
.island-content{position:relative;height:calc(100% - 48px);display:flex;flex-direction:column;padding:0 17px 10px;opacity:0;transform:translateY(-7px);visibility:hidden;transition:opacity 120ms,transform 180ms var(--ease),visibility 0s 180ms}body[data-expanded=true] .brand strong{display:block}body[data-expanded=true] .brand small{display:none}body[data-expanded=true] .expanded-control{display:grid}body[data-expanded=true] .island-content{opacity:1;transform:translateY(0);visibility:visible;transition:opacity 180ms 70ms,transform 260ms 40ms var(--ease),visibility 0s}body[data-expanded=true] .island-header{padding:0 21px}
.context-line{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:1px 4px 12px;font-size:10px;color:#85868d;white-space:nowrap}.context-line>span:first-child{display:flex;align-items:center;gap:6px;min-width:0}#island-context{overflow:hidden;text-overflow:ellipsis}.status-dot{width:4px;height:4px;background:#95d9b8;border-radius:50%;box-shadow:0 0 5px #a1edc94d}#island-time{font-variant-numeric:tabular-nums;color:#74757c}.island-panel{flex:1;min-height:0;overflow:auto;overscroll-behavior:contain;scrollbar-width:thin;scrollbar-color:#ffffff28 transparent;padding:0 3px;animation:panel-in 210ms var(--ease)}
.island-tiles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;height:137px}.tile{position:relative;isolation:isolate;overflow:hidden;border:1px solid #ffffff13;border-radius:17px;text-align:left;padding:13px 13px 11px;display:flex;flex-direction:column;background:#111214;transition:transform 220ms var(--ease),border-color 180ms}.tile:before{content:'';position:absolute;inset:0;z-index:-1;opacity:.65;transition:opacity 450ms,transform 450ms var(--ease);background:radial-gradient(ellipse at 50% 130%,var(--tile-glow),transparent 75%)}.tile:hover{transform:translateY(-2px);border-color:#ffffff2b}.tile:hover:before{opacity:1;transform:scale(1.15)}.tile:active{transform:scale(.98)}.voice-tile{--tile-glow:#284d3b}.tasks-tile{--tile-glow:#192d51}.screen-tile{--tile-glow:#34234e}.tile-top{display:flex;align-items:center;justify-content:space-between;gap:7px;font-size:10px;font-weight:500;color:#d8d8dd}.tile-top>svg{width:21px;height:21px;color:#a3a4ae}.tile-main{display:block;margin-top:auto;letter-spacing:-.045em;font-size:23px;font-weight:560;line-height:1.12;overflow-wrap:break-word}.tile-detail{margin-top:6px;display:block;font-size:10px;line-height:1.4;color:#b4b5bf;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.tile-detail>span{float:right}.tile-orb{width:29px;height:29px;display:flex;align-items:center;justify-content:center;gap:3px;background:radial-gradient(circle at 30% 20%,#b5efd04d,#315844 60%,#203a2c);box-shadow:0 0 18px #a7eabe0b,inset 0 0 0 1px #ffffff15;border-radius:50%}.tile-orb i{width:2px;height:8px;border-radius:3px;background:#d1ffe6}.tile-orb i:nth-child(2){height:13px}.tile-orb i:nth-child(3){height:10px}
.home-foot{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:14px 3px 5px;font-size:10px;color:#8a8c95}.home-foot button{font-size:10px;color:#d4dbd8;padding:3px}.home-foot button:hover{color:var(--mint)}.home-foot>span{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.panel-heading{display:flex;justify-content:space-between;align-items:center;gap:10px;margin:3px 0 14px}.panel-heading h1{font-size:20px;line-height:1.2;margin:0;font-weight:520;letter-spacing:-.035em}.panel-heading>span{font-size:10px;white-space:nowrap;color:#8d9098}.island-nav{flex:none;display:flex;justify-content:center;gap:8px;padding:8px 0 0;margin-top:5px;border-top:1px solid #ffffff0a}.island-nav button{position:relative;display:flex;align-items:center;gap:5px;padding:5px 9px;border-radius:15px;color:#73757e;min-height:27px;font-size:10px}.island-nav svg{width:13px;height:13px}.island-nav button[aria-selected=true]{background:#ffffff13;color:#ededf1}.island-nav button:hover{color:#fff;background:#ffffff0c}#tasks-badge{position:absolute;right:2px;top:1px;width:4px;height:4px;background:#8fb4ff;border-radius:50%}
.job-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:7px}.job-list li{display:grid;grid-template-columns:8px 1fr auto;gap:9px;align-items:center;padding:10px 12px;border:1px solid #ffffff0a;background:#ffffff04;border-radius:12px}.job-dot{width:5px;height:5px;border-radius:50%;background:#9196a1}.job-dot[data-state=running],.job-dot[data-state=planning],.job-dot[data-state=queued]{background:#e4ba85;box-shadow:0 0 8px #e4ba8544}.job-dot[data-state=succeeded]{background:#9ddfb7}.job-dot[data-state=failed],.job-dot[data-state=awaiting_user]{background:#f6a48c}.job-list strong{display:block;font-size:11px;font-weight:500}.job-list p{color:#8d9099;font-size:10px;line-height:1.5;margin:3px 0 0;overflow-wrap:anywhere}.job-state{font-size:9px;color:#a1a4ae}.empty-jobs{grid-column:1/-1;padding:23px 10px;text-align:center}.empty-jobs strong{font-size:13px}.text-button{font-size:10px;color:#b8c6bd;padding:11px 1px 4px}.text-button:hover{color:var(--mint)}
.voice-open{display:flex;align-items:center;gap:10px;width:100%;border:1px solid #ffffff0e;background:#ffffff04;border-radius:13px;padding:10px 12px;text-align:left}.voice-open>span:nth-child(2){flex:1;font-size:12px}.voice-open small,.listen-row small{display:block;font-size:10px;color:#868b94;margin-top:3px}.voice-open>svg{width:14px;color:#858d89}.voice-glyph{display:grid;place-items:center;width:29px;height:29px;background:#b1eacb11;color:var(--mint);border-radius:10px;font-size:17px}.voice-open:hover{background:#a5e6bb0a;border-color:#a3f4d033}.listen-row{position:relative;display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:57px;font-size:11px;cursor:pointer}.listen-row>span:first-child{min-width:0}.listen-row input{position:absolute;right:0;width:34px;height:21px;opacity:0;cursor:pointer;z-index:1;margin:0}.switch{flex:none;width:31px;height:18px;background:#303239;border-radius:20px;padding:3px;transition:background 180ms}.switch:after{content:'';display:block;width:12px;height:12px;border-radius:50%;background:#b9bdc5;transition:transform 180ms var(--ease),background 180ms}.listen-row input:checked+.switch{background:#375f4b}.listen-row input:checked+.switch:after{transform:translateX(13px);background:#c0f1d3}.listen-row input:focus-visible+.switch{outline:2px solid var(--mint);outline-offset:3px}.listen-row input:disabled+.switch{opacity:.4}.work-disclosure{font-size:10px;line-height:1.65;color:#81858e;margin:0;max-width:530px}.translation-offer{border:1px solid #c1dabe26;background:#b2f2bf0a;border-radius:12px;padding:10px;margin:10px 0}.translation-offer p{margin:0 0 8px;font-size:11px}.translation-offer>div{display:flex;gap:8px;flex-wrap:wrap}.translation-offer button,.settings-bottom button{font-size:11px;border-radius:8px;background:#ffffff0b;padding:7px 11px}.primary{background:#c9f5dc!important;color:#183a28;padding:8px 12px;border-radius:9px;font-weight:550}.finish-button{display:block;width:100%;margin:11px 0}#work-aud