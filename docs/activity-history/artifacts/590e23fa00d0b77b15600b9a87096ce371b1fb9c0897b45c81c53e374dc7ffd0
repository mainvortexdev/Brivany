body[data-motion=false] *,body[data-motion=false] *:before,body[data-motion=false] *:after{animation:none!important;transition:none!important}
.opacity-setting{display:flex;align-items:center;gap:12px;min-height:58px;border-top:1px solid #ffffff08}.opacity-setting label{font-size:11px;flex:1}.opacity-setting small{display:block;font-size:10px;color:#868b94;margin-top:3px}.opacity-setting input{width:140px;max-width:34%;accent-color:#aedfc4;cursor:pointer}.opacity-setting output{min-width:33px;text-align:right;font-size:10px;color:#b1c5b9;font-variant-numeric:tabular-nums}
