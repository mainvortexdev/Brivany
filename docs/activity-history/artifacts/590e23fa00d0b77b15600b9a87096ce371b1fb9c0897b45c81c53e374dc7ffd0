#work-status{font-size:10px;line-height:1.5;color:#c8b898;margin:4px 3px 0;flex:none;max-height:35px;overflow:auto}#work-status:empty{display:none}.size-setting{border:0;padding:0;margin:3px 0 10px;display:flex;justify-content:space-between;align-items:center;gap:12px}.size-setting legend{float:left;font-size:11px;color:#c0c1c8;line-height:31px}.size-options{display:flex;background:#191a20;border-radius:20px;padding:3px;gap:1px}.size-options button{font-size:10px;color:#9597a0;padding:5px 13px;border-radius:16px}.size-options button[aria-pressed=true]{background:#ededee;color:#17191d;box-shadow:0 1px 4px #0005}.settings-bottom{display:flex;align-items:center;justify-content:space-between;gap:12px;border-top:1px solid #ffffff0b;padding-top:14px}.settings-bottom #work-close{color:#a79998;background:transparent}.settings-bottom button:hover{color:#e9f5ed;background:#ffffff14}
body[data-mood=working] .tasks-tile{--tile-glow:#79513b}body[data-mood=working] .tasks-tile:before{opacity:1;animation:working-glow 3s ease-in-out infinite}body[data-mood=working] .status-dot{background:#edbf8d}body[data-mood=working] .eye{height:7px;background:#f8e5c7;box-shadow:0 0 8px #ffc57e66}body[data-mood=attention] .eye{height:13px;width:7px;background:#ffdcb9}body[data-mood=attention] .tasks-tile{--tile-glow:#765738}body[data-mood=done] .tasks-tile{--tile-glow:#254c85}body[data-mood=done] .tasks-tile:before{opacity:1}body[data-mood=seen] .tasks-tile{--tile-glow:#2c6949}body[data-mood=error] .tasks-tile{--tile-glow:#6d373a}body[data-mood=listening] .voice-tile,body[data-mood=speaking] .voice-tile{--tile-glow:#386b50}body[data-mood=listening] .signal i,body[data-mood=speaking] .signal i{animation:wave 800ms ease-in-out infinite alternate}body[data-mood=listening] .signal i:nth-child(2n),body[data-mood=speaking] .signal i:nth-child(2n){animation-delay:-300ms}body[data-mood=listening] .signal i:nth-child(3),body[data-mood=speaking] .signal i:nth-child(3){animation-delay:-600ms}body[data-mood=speaking] .tile-orb i{animation:wave 600ms ease-in-out infinite alternate}body[data-demo=true] #island-context{color:#d6b697}
@keyframes blink{0%,42%,44.5%,73%,76%,100%{transform:scaleY(1)}43%,74.5%{transform:scaleY(.08)}}@keyframes wave{from{transform:scaleY(.4)}to{transform:scaleY(1.25)}}@keyframes working-glow{0%,100%{opacity:.62}50%{opacity:1}}@keyframes panel-in{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}
@media(max-width:470px){.island-header{padding:0 14px!important}.island-content{padding:0 11px 9px}.island-tiles{gap:6px}.tile{padding:10px 9px;border-radius:13px}.tile-main{font-size:18px}.tile-top{font-size:9px}.tile-orb{width:24px;height:24px}.tile-top>svg{width:18px;height:18px}.tile-detail{font-size:9px}.context-line{font-size:9px}.island-nav{gap:3px}.island-nav button{padding:5px 7px}.panel-heading h1{font-size:18px}.brand small{max-width:100px}.home-foot{font-size:9px}.home-foot button{font-size:9px}.size-options button{padding:5px 9px}}
