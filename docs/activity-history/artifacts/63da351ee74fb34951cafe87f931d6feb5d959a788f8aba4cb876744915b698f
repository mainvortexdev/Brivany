"""Abstention must not be turned into speaker gender by a pitch heuristic."""
import math
import struct
import threading
import unittest
from unittest.mock import patch

from packages.providers import river_translation as river


UNKNOWN={'voice_timbre':'uncertain','timbre_confidence':.806631,
         'timbre_inference_source':'local_robust_voice_timbre'}


class ProvisionalVoiceStyleTests(unittest.TestCase):
    def setUp(self):
        self.stop=threading.Event()
        self.high=b''.join(struct.pack('<h',round(9000*math.sin(i*math.tau*210/24000))) for i in range(24000))

    def test_actual_high_register_with_unknown_timbre_uses_explicit_provisional_catalog(self):
        self.assertEqual(river.pitch_style(self.high),'high')
        tracker=river.SpeakerTracker()
        voice=tracker.voice('one',self.high,'auto',stopped=self.stop,advisory=dict(UNKNOWN))
        self.assertEqual(voice['style'],'high')
        self.assertEqual((voice['voice_name'],voice['voice_id']),('Daniel',river.VOICES['neutral']))
        self.assertEqual((voice['method'],voice['timbre_source']),('provisional_catalog','provisional_catalog'))
        self.assertTrue(voice['voice_category_provisional'])
        self.assertFalse(voice['voice_category_is_identity'])
        self.assertNotIn('voice_timbre',tracker.turns['one'])
        self.assertIsNone(tracker.cached_timbre('one'))
        self.assertEqual(tracker.variants,{'low':0,'high':0})

    def test_uncertainty_preserves_an_established_confident_catalog_style(self):
        for category in ('masculine','feminine'):
            with self.subTest(category=category):
                tracker=river.SpeakerTracker();tracker.observe('one','A')
                known=dict(UNKNOWN,voice_timbre=category,timbre_confidence=.99)
                first=tracker.voice('one',self.high,'auto',stopped=self.stop,advisory=known)
                tracker.observe('two','A')
                second=tracker.voice('two',self.high,'auto',stopped=self.stop,advisory=dict(UNKNOWN))
                self.assertEqual(second['voice_id'],first['voice_id'])
                self.assertEqual(second['voice_category'],category)
                self.assertFalse(second['voice_category_provisional'])

    def test_confident_female_and_male_matches_choose_actual_catalog_id_without_a_speaker_label(self):
        for category,register,key in [('feminine','low','high'),('masculine','high','low')]:
            with self.subTest(category=category),patch.object(river,'pitch_style',return_value=register):
                tracker=river.SpeakerTracker()
                known=dict(UNKNOWN,voice_timbre=category,timbre_confidence=.99)
                voice=tracker.voice('one',b'speech','auto',stopped=self.stop,advisory=known)
                self.assertEqual(voice['voice_id'],river.VOICES[key])
                self.assertEqual(voice['voice_category'],category)
                self.assertFalse(voice['voice_category_provisional'])

    def test_explicit_voice_choice_keeps_priority_over_unknown_model_advice(self):
        voice=river.SpeakerTracker().voice('one',self.high,'feminine',stopped=self.stop,advisory=dict(UNKNOWN))
        self.assertEqual(voice['voice_id'],river.VOICES['high'])
        self.assertEqual(voice['method'],'manual')
        self.assertFalse(voice['voice_category_provisional'])
