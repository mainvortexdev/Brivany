  $("audio-threshold").addEventListener("input", () => { microphone.meter.threshold = Number($("audio-threshold").value); $("threshold-value").textContent = Number($("audio-threshold").value).toFixed(3); });
  for (const id of ["transcribe-opt-in", "asr-provider", "listen-language", "meeting-consent"]) $(id).addEventListener("change", () => { if (listening || starting) { stopListening(); notice("Ajustes actualizados. Pulsa Comenzar para iniciar con estos permisos."); } updateRecognition(); if(id === "listen-language")updateVoices(); });
  $("voice-select").addEventListener("change", () => { selectedVoice = true; cancelReply(); voice.cancel(); });
  $("cloud-voice-consent").addEventListener("change", () => { cancelReply(); voice.cancel(); });
  $("model-replies").addEventListener("change", () => { cancelReply(); voice.cancel(); });
  window.speechSynthesis?.addEventListener("voiceschanged", updateVoices);
  function updateRecognition() {
    const muse = $("asr-provider").value === "muse";
    $("transcription-disclosure").textContent = muse ? "El audio se envía a Meta mientras escuchas. Brivany no lo guarda. Puedes detenerlo en cualquier momento." : "El navegador puede enviar audio a su proveedor de reconocimiento. Brivany no lo guarda.";
    $("recognition-status").textContent = muse ? liveConfig?.asr.available ? "Muse listo. Detecta turnos; en reuniones distingue hablantes sin identificar personas." : "Falta BRIVANY_MUSE_API_KEY en .env. Después, reinicia Brivany." : microphone.supportsRecognition() ? "Reconocimiento del navegador disponible." : "Este navegador no ofrece reconocimiento de voz.";
    $("transcribe-opt-in").disabled = !muse && !microphone.supportsRecognition();
  }
  window.addEventListener("beforeinstallprompt", event => { event.preventDefault(); deferredInstall = event; $("install-app").hidden = false; });
  $("install-app").addEventListener("click", async () => { if (deferredInstall) { await deferredInstall.prompt(); deferredInstall = null; $("install-app").hidden = true; } });
  window.addEventListener("pagehide", stopListening);
  document.addEventListener("visibilitychange", () => { if (document.hidden && (listening || starting || voice.speaking)) { stopListening(); notice("Escucha pausada al salir de Brivany. Pulsa Comenzar cuando vuelvas."); } });
  if ("serviceWorker" in navigator) navigator.serviceWorker.register("/sw.js").catch(() => {});
  updateVoices(); updateRecognition(); renderPhrases(); stage();
  function refreshConnections() { return fetch("/api/status", { cache: "no-store" }).then(response => { if (!response.ok) throw Error(); return response.json(); }).then(data => {
    liveConfig = data.voice || null; modelReady = data.provider?.configured === true; updateVoices(); updateRecognition();
    $("connection-label").textContent = liveConfig?.asr.available ? modelReady ? "Melodi · Muse conectado" : "Muse + Melodi · guía local" : "Muse por configurar · guía local";
  }).catch(() => { $("connection-label").textContent = "Sin conexión · modo local"; }); }
  refreshConnections();
  if (new URL(location.href).searchParams.get("setup") === "meta") {
    openMetaKey(); history.replaceState(null, "", location.pathname);
  }
})();
