(() => {
 const container=document.querySelector('[data-section="general"]');if(!container)return;
 const owner=parent.location.origin===location.origin?parent:window,api=()=>owner.pywebview?.api;
 const card=document.createElement('section');card.className='brivany-account';card.innerHTML='<h2>Cuenta Brivany</h2><div id="account-profile" hidden><div class="setting-row"><span id="account-name"></span><button id="account-logout" type="button">Cerrar sesión</button></div><div id="account-computers"></div></div><form id="account-login" autocomplete="on"><label>Correo<input name="email" type="email" autocomplete="username" required></label><label>Contraseña<input name="password" type="password" autocomplete="current-password" required></label><button type="submit">Iniciar sesión</button></form><p id="account-message" role="status"></p>';
 container.prepend(card);let busy=false;
 const message=text=>card.querySelector('#account-message').textContent=text||'';
 async function refresh(){if(!api()?.account_status||busy)return;try{const state=await api().account_status();const identity=state.account?.id||null;if(owner.BrivanyChatAccount!==identity){owner.BrivanyChatAccount=identity;owner.dispatchEvent(new owner.CustomEvent('brivany-account-change'));if(owner.BrivanyChatSession){owner.BrivanyChatSession.messages=[];owner.BrivanyChatSession.history=[];owner.BrivanyChatSession.id=crypto.randomUUID();}}card.querySelector('#account-login').hidden=state.signed_in;card.querySelector('#account-profile').hidden=!state.signed_in;if(state.signed_in){card.querySelector('#account-name').textContent=state.account.name+' · '+state.account.email;const result=await api().account_devices(),list=card.querySelector('#account-computers');list.replaceChildren();for(const device of result.devices.filter(d=>d.kind==='desktop'&&d.enabled!==false)){const row=document.createElement('div');row.className='setting-row';const name=document.createElement('span'),status=document.createElement('small');name.textContent=device.name;status.textContent=device.online?'Conectado':'Sin conexión';row.append(name,status);list.append(row);}message(state.error||(state.connected?'Móvil y ordenador vinculados a tu cuenta.':'Conectando este ordenador…'));}}catch{message('No se pudo consultar la cuenta.');}}
 card.querySelector('#account-login').onsubmit=async event=>{event.preventDefault();if(busy)return;busy=true;const form=event.currentTarget;form.querySelector('button').disabled=true;message('Conectando…');try{await api().account_login(form.elements.email.value,form.elements.password.value);form.elements.password.value='';}catch{message('No se pudo iniciar sesión. Revisa el correo y la contraseña.');}finally{busy=false;form.querySelector('button').disabled=false;await refresh();}};
 card.querySelector('#account-logout').onclick=async()=>{await api().account_logout();message('');await refresh()};
 const timer=setInterval(refresh,5000);window.addEventListener('pagehide',()=>clearInterval(timer),{once:true});refresh();
})();
