<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="color-scheme" content="dark"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Melodi WorkSpace</title><link rel="stylesheet" href="/desktop-shell/island.css"><link rel="stylesheet" href="/desktop-shell/workspace-music.css"><link rel="stylesheet" href="/desktop-shell/character.css"><script src="/desktop-shell/music-motion.js" defer></script><script src="/desktop-shell/island.js" defer></script><link rel="stylesheet" href="/typography.css"><link rel="stylesheet" href="/desktop-shell/workspace-tools.css"><link rel="stylesheet" href="/desktop-shell/workspace-companion.css"><script src="/desktop-shell/research-citations.js" defer></script><script src="/desktop-shell/workspace-companion.js" defer></script><link rel="stylesheet" href="/desktop-shell/workspace-translation.css"><script src="/desktop-shell/workspace-translation.js" defer></script><link rel="stylesheet" href="/desktop-shell/workspace-agents.css"><script src="/desktop-shell/workspace-agents.js" defer></script><link id="glisse-styles" rel="stylesheet" href="/desktop-shell/glisse.css"><link rel="stylesheet" href="/desktop-shell/workspace-results.css"><script src="/desktop-shell/workspace-results.js" defer></script></head>
<body data-expanded="false" data-sleeping="false">
<main id="island" aria-label="Melodi WorkSpace">
 <header class="toolstrip" aria-label="Herramientas de Melodi"><div class="workspace-waves" aria-hidden="true"><svg viewBox="0 0 1920 48" preserveAspectRatio="none"><path d="M0 24 Q60 2 120 24 T240 24 Q300 2 360 24 T480 24 Q540 2 600 24 T720 24 Q780 2 840 24 T960 24 Q1020 2 1080 24 T1200 24 Q1260 2 1320 24 T1440 24 Q1500 2 1560 24 T1680 24 Q1740 2 1800 24 T1920 24 "/></svg><svg viewBox="0 0 1920 48" preserveAspectRatio="none"><path d="M0 24 Q60 2 120 24 T240 24 Q300 2 360 24 T480 24 Q540 2 600 24 T720 24 Q780 2 840 24 T960 24 Q1020 2 1080 24 T1200 24 Q1260 2 1320 24 T1440 24 Q1500 2 1560 24 T1680 24 Q1740 2 1800 24 T1920 24 "/></svg><svg viewBox="0 0 1920 48" preserveAspectRatio="none"><path d="M0 24 Q60 2 120 24 T240 24 Q300 2 360 24 T480 24 Q540 2 600 24 T720 24 Q780 2 840 24 T960 24 Q1020 2 1080 24 T1200 24 Q1260 2 1320 24 T1440 24 Q1500 2 1560 24 T1680 24 Q1740 2 1800 24 T1920 24 "/></svg></div>
  <nav id="tools" aria-label="Herramientas"><div class="tool-group tools-left"><button id="workspace-brand" class="workspace-brand" aria-label="Abrir Brivany">brivany<span>.</span></button><button id="workspace-audio" aria-label="Traducción auditiva"><span>Traducción auditiva</span></button><button id="work-region" aria-label="Selección de área"><span>Selección de área</span></button></div><div class="melodi-family" aria-label="Melodi y sus agentes"><div id="agents-left" class="agent-siblings"></div><button id="workspace-melodi" class="eye-bay" data-panel="melodi" aria-label="Melodi" aria-haspopup="dialog"><div class="eye-track"><span class="eye-wander"><span class="face melodi-character"><span class="mascot-shadow"></span><span class="mascot-hand left"></span><span class="mascot-hand right"></span><span class="mascot-body"><span class="mascot-headphones"><i class="headphone-band"></i><i class="headphone-cup left"></i><i class="headphone-cup right"></i></span><span class="mascot-look"><i class="eye"></i><i class="eye"></i></span><i class="mascot-cheek left"></i><i class="mascot-cheek right"></i></span><span class="mascot-sleep">z</span></span></span></div></button><div id="agents-right" class="agent-siblings"></div></div><div class="tool-group tools-right"><button data-panel="music" aria-label="Música"><span>Música</span></button><button id="workspace-open-app" aria-label="Abrir app"><span>Abrir app</span></button></div></nav>
 </header>
 <div id="island-content" inert>
  <div class="panel-top"><span id="panel-label">Música</span><button id="island-collapse" class="icon-button" aria-label="Cerrar panel"><svg viewBox="0 0 24 24"><path d="m7 7 10 10M7 17 17 7"/></svg></button></div>
  <section data-view="melodi" hidden><div class="companion-actions"><button id="companion-write">Escribir a Melodi</button><button id="companion-talk">Hablar con Melodi</button></div><p id="companion-error" class="fine" role="status"></p></section>
  <section data-view="result" hidden><div id="workspace-result"></div></section><section data-view="agent" hidden><div id="agent-detail"><h2 id="agent-title"></h2><p id="agent-phase"></p><div id="agent-attempt"></div><div class="agent-detail-actions"><button id="agent-review">Ver resultado</button><button id="agent-cancel">Cancelar</button></div></div></section>
  <section data-view="chat" hidden>
   <div id="workspace-chat-messages" role="log" aria-label="Conversación con Melodi" aria-live="polite"></div>
   <form id="workspace-chat-form">
    <textarea id="workspace-chat-input" aria-label="Escribir a Melodi" placeholder="Escribe a Melodi…" maxlength="1200" rows="2"></textarea>
    <button id="workspace-chat-mic" type="button" aria-label="Dictar mensaje"><svg viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M6 10v2a6 6 0 0 0 12 0v-2m-6 8v3m-3 0h6"/></svg></button>
    <button id="workspace-chat-send" aria-label="Enviar a Melodi"><svg viewBox="0 0 24 24"><path d="M12 19V5m-6 6 6-6 6 6"/></svg></button>
    <div id="workspace-dictation" role="group" aria-label="Dictado de mensaje" hidden>
     <button id="workspace-dictation-cancel" type="button" aria-label="Cancelar dictado"><svg viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
     <canvas id="workspace-dictation-wave" aria-hidden="true"></canvas>
     <span id="workspace-dictation-state" role="status" class="dictation-sr"></span>
     <button id="workspace-dictation-stop" type="button" aria-label="Detener dictado"><svg viewBox="0 0 24 24"><rect x="6" y="6" width="12" height="12" rx="2" fill="currentColor" stroke="none"/></svg></button>
     <button id="workspace-dictation-send" type="button" aria-label="Enviar dictado"><svg viewBox="0 0 24 24"><path d="M12 19V5m-6 6 6-6 6 6"/></svg></button>
    </div>
   </form><p id="workspace-chat-status" role="status"></p>
  </section>
  <section data-view="auditory" hidden>
   <div class="auditory-modes" aria-label="Modo de traducción"><button data-auditory-mode="direct" aria-pressed="true">Directa</button><button data-auditory-mode="preproduction" aria-pressed="false">Preproducción</button><button data-auditory-mode="synchronized" aria-pressed="false">Navegador</button></div>
   <div id="auditory-controls"><div id="auditory-target" role="group" aria-label="Idioma de traducción"><button data-auditory-target="en" aria-pressed="true">English</button><button data-auditory-target="es" aria-pressed="false">Español</button><button data-auditory-target="fr" aria-pressed="false">Français</button></div><div class="auditory-voices" aria-label="Voz de traducción"><button data-auditory-voice="auto" aria-pressed="true">Auto</button><button data-auditory-voice="masculine" aria-pressed="false">Masculina</button><button data-auditory-voice="feminine" aria-pressed="false">Femenina</button></div></div>
   <div class="auditory-content"><span id="auditory-speaker"></span><p id="auditory-caption" aria-live="polite"></p></div><div id="auditory-footer"><p id="auditory-status" role="status"></p><button id="auditory-toggle">Iniciar</button></div>
  </section>
  <section data-view="music" hidden>
   <div id="spotify-setup"><button id="spotify-connect" class="primary">Vincular Spotify <span aria-hidden="true">↗</span></button><p id="spotify-pending" class="fine" hidden>Completa el inicio de sesión en tu navegador. Este panel se actualizará al volver.</p><p id="spotify-storage" class="fine" hidden>La sesión se conserva mientras Brivany esté abierto en este sistema.</p></div>
   <div id="spotify-player" hidden>
    <div class="player-strip">
     <div class="now-playing"><div class="cover"><img id="track-art" alt="Portada del álbum" hidden><div class="art-empty" aria-hidden="true">♪</div></div><div class="track-meta"><span id="track-state" class="track-state"></span><h1 id="track-title">Sin reproducción activa</h1><p id="track-artist">Elige música de tu biblioteca.</p></div></div>
     <div id="music-lyrics-view" class="inline-lyrics"><div id="lyrics-lines" tabindex="0" aria-label="Letra de la canción. Desplaza para leer letras sin sincronizar." aria-live="off"></div></div>
     <div class="transport"><div class="playback-controls"><button id="music-shuffle" class="icon-button" aria-label="Aleatorio" aria-pressed="false" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h2c5 0 7 10 12 10h2m-4-3 4 3-4 3M4 17h2c2 0 3-2 4-4m4-2c1-2 2-4 4-4h2m-4-3 4 3-4 3"/></svg></button><button id="music-prev" class="icon-button" aria-label="Canción anterior" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5v14"/><path d="m18 5-10 7 10 7Z" class="solid"/></svg></button><button id="music-play" class="play-button" aria-label="Reproducir" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 11 7-11 7Z" class="solid play-glyph"/><path d="M8 5h3v14H8zm6 0h3v14h-3z" class="solid pause-glyph"/></svg></button><button id="music-next" class="icon-button" aria-label="Canción siguiente" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 5v14"/><path d="m6 5 10 7-10 7Z" class="solid"/></svg></button><button id="music-repeat" class="icon-button" aria-label="Repetir" aria-pressed="false" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m17 2 4 4-4 4M3 11V9a3 3 0 0 1 3-3h15M7 22l-4-4 4-4m14-1v2a3 3 0 0 1-3 3H3"/></svg></button></div><div class="seek-row"><time id="music-elapsed">0:00</time><input id="music-seek" type="range" min="0" max="100" value="0" aria-label="Posición de reproducción" disabled><time id="music-duration">0:00</time></div></div>
    </div>
    <div class="player-tools"><div class="music-navigation"><button id="music-refresh" class="music-tool refresh-music" aria-label="Actualizar reproducción"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 8a8 8 0 1 0 0 8M20 3v5h-5"/></svg></button><button data-music-view="library" class="music-tool" aria-label="Abrir biblioteca" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4v16M9 4v16m5-16 5 16M3 20h18"/></svg><span>Biblioteca</span></button></div><div class="device-tools"><button id="music-here" class="music-tool">Escuchar aquí</button><button id="music-device" class="music-tool" aria-label="Dispositivos de reproducción" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="13" height="11" rx="2"/><path d="M6 18h6m-3-4v4"/><rect x="17" y="9" width="4" height="12" rx="1"/></svg><span id="music-device-name">Dispositivos</span></button><label class="volume-control"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m11 4-6 5H2v6h3l6 5Zm4 4a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14"/></svg><input id="music-volume" type="range" min="0" max="100" value="50" aria-label="Volumen" disabled></label></div></div>
    <div id="music-devices-view" hidden><p class="music-section-label">Escuchar en</p><div id="music-devices" role="group" aria-label="Dispositivos disponibles"></div><p class="fine">Abre Spotify en el dispositivo que quieras usar.</p></div>
    <div id="music-library-view" hidden><div class="library-tabs" role="tablist" aria-label="Tu biblioteca"><button data-library="playlists" role="tab" aria-selected="true">Playlists</button><button data-library="albums" role="tab" aria-selected="false">Álbumes</button><button data-library="tracks" role="tab" aria-selected="false">Canciones</button></div><div id="music-library" role="group" aria-label="Biblioteca de Spotify"></div></div>

   </div><p id="music-status" role="status" class="fine"></p>
  </section>
  <p id="work-status" role="status" aria-live="polite"></p>
 </div>
</main></body></html>
